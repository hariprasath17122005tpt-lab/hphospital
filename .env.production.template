# ============================================================
#  Hospital Management System — AWS Production Environment
#  
#  INSTRUCTIONS:
#    1. Copy this file:  cp .env.production.template .env.production
#    2. Fill in every REPLACE_WITH_* value below
#    3. NEVER commit .env.production to Git (it's in .gitignore)
#
#  Generate SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production

# REQUIRED: Generate a unique strong key — change before deploying
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY_RUN_python_-c_import_secrets_print_secrets.token_hex_32

# ── AWS RDS MySQL (Permanent Patient Data Storage) ────────────────────────────
# Found in: AWS Console → RDS → Databases → your instance → Connectivity & security
USE_SQLITE=false

# Example: hospital-prod.c9akciq32yz2.ap-south-1.rds.amazonaws.com
DB_HOST=REPLACE_WITH_RDS_ENDPOINT

DB_PORT=3306
DB_NAME=hospital_db
DB_USER=REPLACE_WITH_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── AWS S3 (Medical Document / Scan Storage) ──────────────────────────────────
# Found in: AWS Console → IAM → your IAM user → Security credentials
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=REPLACE_WITH_S3_BUCKET_NAME
AWS_REGION=ap-south-1

# ── AI / Groq API ─────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
