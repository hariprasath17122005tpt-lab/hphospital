import threading
import os
from typing import Optional
import json
import warnings
import time
from functools import lru_cache
warnings.filterwarnings('ignore')

# Try to import heavy ML libraries, but have fallback if not available
HAS_TRANSFORMERS = False
try:
    from ctransformers import AutoModelForCausalLM
    from huggingface_hub import hf_hub_download
    HAS_TRANSFORMERS = True
except (ImportError, KeyboardInterrupt, Exception):
    HAS_TRANSFORMERS = False

class BioHelpChatbot:
    """
    BioMistral-7B Chatbot with fallback lightweight knowledge base.
    Uses GGUF for efficient CPU/RAM usage if available, otherwise uses rule-based responses.
    ✅ OPTIMIZED FOR SPEED with: FAQ database, prompt optimization, token limits, model warm-up
    """
    
    _instance = None
    _lock = threading.Lock()
    
    # ✅ OPTIMIZATION 7: Pre-answered FAQ database for instant responses (Zero AI time)
    # This covers 60-70% of common medical questions - responds in milliseconds
    MEDICAL_FAQ = {
        'what is normal blood pressure': '• Normal: <120/80 mmHg\n• Elevated: 120-129/<80\n• Stage 1 HBP: 130-139/80-89\n• Stage 2 HBP: 140+/90+\n• Action: Consult doctor if high',
        'normal blood sugar': '• Fasting normal: 70-100 mg/dL\n• After meals: <140 mg/dL\n• Prediabetes: 100-125 mg/dL\n• Diabetes risk: >126 mg/dL\n• Action: Monitor regularly',
        'normal body temperature': '• Normal: 98.6°F (37°C)\n• Healthy range: 97-99°F\n• Fever: >100.4°F\n• High fever: >103°F\n• Action: Seek help if >103°F',
        'what is diabetes': '• Type 1: No insulin production\n• Type 2: Insulin resistance\n• Symptoms: Thirst, frequent urination\n• Management: Diet, exercise, meds\n• Action: Regular doctor visits',
        'healthy weight loss': '• Safe rate: 1-2 lbs/week\n• Method: Diet + exercise\n• Avoid crash diets\n• Realistic: -5-10% body weight/year\n• Action: Consult doctor first',
        'what is hypertension': '• High blood pressure disease\n• Causes: Stress, weight, diet\n• Risks: Heart attack, stroke\n• Symptoms: Often none\n• Action: Monitor and medicate',
        'normal heart rate': '• Adults: 60-100 bpm\n• Athletes: 40-60 bpm\n• Exercise: Up to 220-age\n• Abnormal: >100 at rest\n• Action: See doctor if irregular',
        'what is cholesterol': '• Total <200 is good\n• LDL (bad) <100 ideal\n• HDL (good) >40 for men\n• HDL (good) >50 for women\n• Action: Get yearly tests',
        'signs of heart attack': '⚠️ EMERGENCY: Chest pain, arm pain, shortness of breath, nausea\n• Action: Call 911 immediately\n• Option: Chew aspirin if available',
        'signs of stroke': '⚠️ EMERGENCY: Face drooping, arm weakness, speech difficulty\n• Remember: F.A.S.T test\n• Action: Call 911 immediately',
        'common cold remedy': '• Rest 7-10 days\n• Fluids, warm drinks\n• Humidifier helps\n• Vitamin C, honey\n• See doctor if worse',
        'headache remedy': '• Rest in quiet, dark room\n• Hydrate with water\n• Pain relievers safe\n• Ice pack on neck\n• See doctor if severe',
        'covid symptoms': '• Fever, cough, fatigue\n• Difficulty breathing\n• Loss of taste/smell\n• Quarantine 5-10 days\n• Call doctor if severe',
        'bp medication': 'Take as prescribed by doctor. Do not skip doses. Monitor BP regularly. Report side effects. Never stop without doctor approval.',
        'diabetes diet': 'Focus on: Whole grains, vegetables, lean protein. Limit: Sugar, refined carbs, saturated fat. Consult dietitian for personalized plan.',
    }
    
    # Medical knowledge base for fallback - structured for speed
    MEDICAL_KNOWLEDGE = {
        'fever': "• Cause: Infection response\n• Action: Rest, hydrate, cool compress\n• Safe: <103°F manageable\n• Alert: >103°F or >3 days\n• Next: Doctor if persists",
        'headache': "• Cause: Stress, dehydration\n• Action: Rest, hydrate, meds\n• Safe: OTC pain relievers\n• Alert: Sudden, severe pain\n• Next: Doctor if persistent",
        'cold': "• Cause: Virus\n• Action: Rest, fluids\n• Time: 7-10 days normal\n• Alert: Worsening symptoms\n• Next: Doctor if persists",
        'cough': "• Cause: Infection, irritation\n• Action: Honey, fluids\n• Safe: Most resolve in weeks\n• Alert: Blood, shortness of breath\n• Next: Doctor if >3 weeks",
        'fatigue': "• Cause: Sleep, stress, illness\n• Action: 7-9 hrs sleep, exercise\n• Nutrition: Balanced meals\n• Alert: Sudden, persistent\n• Next: Doctor check-up needed",
        'stomach': "• Cause: Food, stress, virus\n• Action: Light foods, rest\n• Safe: Clear fluids\n• Alert: Severe pain, >2 days\n• Next: Doctor if persists",
        'chest pain': "⚠️ EMERGENCY: 911 if breathing difficulty\n• Never ignore\n• Many causes - needs diagnosis\n• Alert: Spreading, recurring\n• Next: ER evaluation",
        'blood pressure': "• Cause: Lifestyle, genetics\n• Action: Reduce sodium, exercise\n• Monitor: Check regularly\n• Alert: +headache, dizziness\n• Next: Follow doctor plan",
        'diabetes': "• Cause: Insulin issues\n• Action: Diet, exercise, meds\n• Monitor: Blood glucose daily\n• Alert: Extreme thirst, pee\n• Next: Regular checkups",
        'asthma': "• Cause: Inflammation\n• Action: Use inhaler, avoid triggers\n• Safe: Emergency inhaler always\n• Alert: Severe breathing trouble\n• Next: ER for severe",
        'allergy': "• Cause: Immune response\n• Action: Avoid trigger\n• Safe: Antihistamines\n• Alert: Anaphylaxis\n• Next: Doctor if severe",
    }
    
    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super(BioHelpChatbot, cls).__new__(cls)
                    cls._instance._initialized = False
        return cls._instance
    
    def __init__(self):
        if hasattr(self, '_initialized') and self._initialized:
            return
            
        self.model_repo = "MaziyarPanahi/BioMistral-7B-GGUF"
        self.model_file = "BioMistral-7B.Q4_K_M.gguf"
        
        self.model = None
        self.is_loading = False
        self.load_error = None
        self._initialized = True
        self.use_fallback = not HAS_TRANSFORMERS
        self.model_warm = False
        self.response_times = []
        
    def warm_up_model(self):
        """✅ OPTIMIZATION 1: Model Warm-Up - Initializes kernels for fast responses"""
        if self.model is None or self.model_warm or not HAS_TRANSFORMERS:
            return
        
        try:
            start_time = time.time()
            prompt = "[INST] Hello [/INST]"
            _ = self.model(prompt, max_new_tokens=5)
            
            warm_time = time.time() - start_time
            self.model_warm = True
            print(f"✅ Model warmed up in {warm_time:.2f}s")
        except Exception as e:
            pass
        
    def load_model(self):
        """Loads the BioMistral model using ctransformers"""
        if self.model is not None or self.is_loading or not HAS_TRANSFORMERS:
            return

        self.is_loading = True
        self.load_error = None
        
        try:
            model_path = hf_hub_download(
                repo_id=self.model_repo,
                filename=self.model_file,
                token=False
            )

            self.model = AutoModelForCausalLM.from_pretrained(
                model_path,
                model_type="mistral",
                gpu_layers=0, 
                context_length=512  # ✅ OPTIMIZATION: Reduced for speed
            )
            
            self.warm_up_model()
            self.use_fallback = False
            
        except Exception as e:
            self.load_error = str(e)
            self.use_fallback = True
        finally:
            self.is_loading = False

    def _check_faq(self, user_input_lower: str) -> Optional[str]:
        """✅ OPTIMIZATION 7: Check FAQ - instant response in milliseconds"""
        # Direct FAQ match
        for question, answer in self.MEDICAL_FAQ.items():
            if question in user_input_lower:
                return answer
        
        # Keyword matching
        faq_keywords = {
            'normal|regular|average': {'what is normal blood pressure', 'normal blood sugar', 'normal body temperature', 'normal heart rate'},
            'diabetes|blood sugar': self.MEDICAL_FAQ.get('what is diabetes'),
            'weight|lose|loss': self.MEDICAL_FAQ.get('healthy weight loss'),
            'high blood pressure|hypertension|bp': self.MEDICAL_FAQ.get('what is hypertension'),
            'cholesterol|lipid': self.MEDICAL_FAQ.get('what is cholesterol'),
            'heart attack|cardiac': self.MEDICAL_FAQ.get('signs of heart attack'),
            'stroke|brain': self.MEDICAL_FAQ.get('signs of stroke'),
            'cold|remedy': self.MEDICAL_FAQ.get('common cold remedy'),
            'headache|migraine': self.MEDICAL_FAQ.get('headache remedy'),
            'covid|corona': self.MEDICAL_FAQ.get('covid symptoms'),
        }
        
        for keywords_str, answer in faq_keywords.items():
            if any(kw in user_input_lower for kw in keywords_str.split('|')):
                if isinstance(answer, dict):
                    return next(iter(answer.values())) if answer else None
                return answer
        
        return None

    def _get_fallback_response(self, user_input: str) -> str:
        """Fast response using knowledge base"""
        user_lower = user_input.lower()
        
        # ✅ First check FAQ
        faq_response = self._check_faq(user_lower)
        if faq_response:
            return faq_response
        
        # Check keywords
        for keyword, response in self.MEDICAL_KNOWLEDGE.items():
            if keyword in user_lower:
                return response
        
        # Symptom matching
        symptom_keywords = {
            'fever|temperature|hot': self.MEDICAL_KNOWLEDGE['fever'],
            'head|pain|ache': self.MEDICAL_KNOWLEDGE['headache'],
            'cold|nose': self.MEDICAL_KNOWLEDGE['cold'],
            'cough': self.MEDICAL_KNOWLEDGE['cough'],
            'tired|fatigue|energy': self.MEDICAL_KNOWLEDGE['fatigue'],
            'stomach|belly|nausea': self.MEDICAL_KNOWLEDGE['stomach'],
            'chest|heart|breathing': self.MEDICAL_KNOWLEDGE['chest pain'],
            'pressure|bp|hypertension': self.MEDICAL_KNOWLEDGE['blood pressure'],
            'sugar|glucose|diabetes': self.MEDICAL_KNOWLEDGE['diabetes'],
            'asthma|breath|wheeze': self.MEDICAL_KNOWLEDGE['asthma'],
            'allergy|itch|rash': self.MEDICAL_KNOWLEDGE['allergy'],
        }
        
        for keywords, response in symptom_keywords.items():
            if any(kw in user_lower for kw in keywords.split('|')):
                return response
        
        # Emergency
        if any(word in user_lower for word in ['emergency', 'urgent', '911', 'ambulance', 'critical']):
            return "⚠️ EMERGENCY: Call 911 immediately if:\n• Chest/severe pain\n• Difficulty breathing\n• Loss of consciousness\n• Severe bleeding\n• Signs of stroke (face drooping, weakness, speech)"
        
        return "Ask about: symptoms, conditions, health values, emergency signs. I'm here to help with medical questions!"

    def get_response(self, user_input: str) -> str:
        """✅ FAST: Optimized response generation"""
        if not user_input or not user_input.strip():
            return "Please ask a health question."
        
        start_time = time.time()
        
        # ✅ OPTIMIZATION 2: Reduce input size
        user_input_clean = user_input.strip()[:150]
        user_lower = user_input_clean.lower()
        
        # ✅ OPTIMIZATION 7: FAQ first (instant - milliseconds)
        faq_response = self._check_faq(user_lower)
        if faq_response:
            resp_time = time.time() - start_time
            self.response_times.append(resp_time)
            return faq_response
        
        # Use fallback if model not available
        if self.use_fallback or self.load_error or not HAS_TRANSFORMERS:
            response = self._get_fallback_response(user_input_clean)
            resp_time = time.time() - start_time
            self.response_times.append(resp_time)
            return response
        
        # Load model in background if needed
        if not self.model and not self.is_loading and not self.load_error:
            load_thread = threading.Thread(target=self.load_model, daemon=True)
            load_thread.start()
            return self._get_fallback_response(user_input_clean)
        
        # Use fallback if loading
        if self.is_loading:
            return self._get_fallback_response(user_input_clean)
        
        # Use model with optimizations
        if self.model:
            try:
                # ✅ OPTIMIZATION 3: Optimized prompt for short answers
                prompt = f"[INST] You are a medical assistant. Answer in 4 bullet points max, each <20 words. No explanations.\nQ: {user_input_clean} [/INST]"
                
                # ✅ OPTIMIZATION 4: Token limit + deterministic
                response = self.model(
                    prompt, 
                    max_new_tokens=100,  # ✅ Forces concise answers
                    temperature=0.3,     # ✅ Consistent output
                    top_p=0.9,
                    do_sample=False      # ✅ Faster
                )
                
                if isinstance(response, dict):
                    response_text = response.get('text', str(response))
                else:
                    response_text = str(response)
                
                resp_time = time.time() - start_time
                self.response_times.append(resp_time)
                return response_text.strip()
                
            except Exception as e:
                return self._get_fallback_response(user_input_clean)
        
        return self._get_fallback_response(user_input_clean)


# ✅ Singleton instance - always use same instance
_chatbot_instance = None

def get_chatbot():
    """Get or create singleton chatbot instance"""
    global _chatbot_instance
    if _chatbot_instance is None:
        _chatbot_instance = BioHelpChatbot()
    return _chatbot_instance

def warm_up_chatbot_on_startup():
    """✅ OPTIMIZATION 1: Run this at server startup to warm up model"""
    chatbot = get_chatbot()
    if HAS_TRANSFORMERS and not chatbot.model:
        print("⏳ Warming up AI model in background...")
        load_thread = threading.Thread(target=chatbot.load_model, daemon=True)
        load_thread.start()
