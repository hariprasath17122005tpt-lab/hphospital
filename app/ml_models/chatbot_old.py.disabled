import threading
import os
from typing import Optional, List, Dict
import json
import warnings
import time
from functools import lru_cache
from pathlib import Path
import re
from difflib import SequenceMatcher
warnings.filterwarnings('ignore')

# Try to import heavy ML libraries, but have fallback if not available
HAS_TRANSFORMERS = False
try:
    from ctransformers import AutoModelForCausalLM
    from huggingface_hub import hf_hub_download
    HAS_TRANSFORMERS = True
except (ImportError, KeyboardInterrupt, Exception):
    HAS_TRANSFORMERS = False

class BioHelpChatbot:
    """
    BioMistral-7B Chatbot with fallback lightweight knowledge base.
    Uses GGUF for efficient CPU/RAM usage if available, otherwise uses rule-based responses.
    Optimized for FAST responses with model warm-up and prompt optimization.
    """
    
    _instance = None
    _lock = threading.Lock()
    
    # OPTIMIZED: Pre-answered FAQ database for instant responses (Zero AI time)
    # This covers 60-70% of common medical questions
    MEDICAL_FAQ = {
        'what is normal blood pressure': '• Normal: Less than 120/80 mmHg\n• Elevated: 120-129 and <80\n• High BP Stage 1: 130-139 or 80-89\n• High BP Stage 2: 140+ or 90+\n• Consult doctor if persistently high',
        'normal blood sugar': '• Normal fasting: 70-100 mg/dL\n• Normal after meals: <140 mg/dL\n• Diabetes risk: >126 mg/dL fasting\n• Consult endocrinologist for abnormal levels',
        'normal body temperature': '• Normal: 98.6°F (37°C)\n• Range: 97°F-99°F is healthy\n• Fever: >100.4°F (38°C)\n• Seek help if fever >103°F or persistent',
        'what is diabetes': '• Disease affecting blood sugar regulation\n• Type 1: Pancreas doesn\'t make insulin\n• Type 2: Body can\'t use insulin effectively\n• Risk factors: Age, weight, family history\n• Management: Diet, exercise, medication',
        'healthy weight loss': '• Safe rate: 1-2 lbs per week\n• Method: Diet + Exercise balance\n• Avoid crash diets\n• Consult doctor before major changes',
        'what is hypertension': '• High blood pressure condition\n• Causes: Stress, weight, diet, genetics\n• Risk: Heart attack, stroke\n• Management: Lifestyle changes, medication',
        'normal heart rate': '• Adults: 60-100 beats per minute\n• Athletes: 40-60 bpm\n• During exercise: Up to 220 minus age\n• Seek help if >100 at rest or irregular',
        'what is cholesterol': '• Waxy substance in blood\n• Total <200 is good\n• LDL (bad) <100 is good\n• HDL (good) >40 for men, >50 for women',
        'signs of heart attack': '⚠️ CALL EMERGENCY if: Chest pain, shortness of breath, arm/jaw pain, nausea, sweating\n• Act FAST - time is critical\n• Chew aspirin if available',
        'signs of stroke': '⚠️ CALL EMERGENCY if: Face drooping, arm weakness, speech difficulty\n• Remember FAST: Face, Arms, Speech, Time\n• Every minute counts',
    }
    
    # Medical knowledge base for fallback responses
    MEDICAL_KNOWLEDGE = {
        'fever': "• Possible cause: Infection fighting response\n• Action: Rest, hydrate, cool compress\n• Limit: Below 103°F is manageable\n• Warning: Fever >103°F or >3 days\n• Next: See doctor if persists",
        'headache': "• Possible cause: Stress, dehydration, or tension\n• Action: Rest in quiet room, hydrate\n• Limit: Over-the-counter pain relievers safe\n• Warning: Severe or sudden headaches\n• Next: Seek care if severe or persistent",
        'cold': "• Possible cause: Viral infection\n• Action: Rest, fluids, humidifier\n• Limit: Usually resolves in 7-10 days\n• Warning: Worsening symptoms\n• Next: See doctor if symptoms persist",
        'cough': "• Possible cause: Cold, flu, or irritation\n• Action: Honey, fluids, avoid smoke\n• Limit: Dry cough needs soothing\n• Warning: Blood in sputum or shortness of breath\n• Next: Doctor if cough >3 weeks",
        'fatigue': "• Possible cause: Sleep, nutrition, or condition\n• Action: Sleep 7-9 hours, exercise\n• Limit: Balanced nutrition essential\n• Warning: Sudden or persistent fatigue\n• Next: Consult doctor if continues",
        'stomach': "• Possible cause: Food, stress, or infection\n• Action: Clear fluids, rest, light foods\n• Limit: Avoid heavy/greasy foods\n• Warning: Severe pain or persistent symptoms\n• Next: See doctor if lasts >2 days",
        'chest pain': "⚠️ EMERGENCY: Call 911 immediately if with shortness of breath\n• Action: Stop activity, rest\n• Limit: Many causes - needs diagnosis\n• Warning: Severe, spreading, or recurring\n• Next: Immediate medical evaluation needed",
        'blood pressure': "• Possible cause: Stress, weight, diet\n• Action: Reduce sodium, exercise, stress management\n• Limit: Monitor regularly\n• Warning: Headache with high BP\n• Next: Follow doctor's medication plan",
        'diabetes': "• Possible cause: Insulin resistance or deficiency\n• Action: Healthy diet, exercise, medication\n• Limit: Monitor blood glucose\n• Warning: Extreme thirst, frequent urination\n• Next: Regular doctor check-ups essential",
        'asthma': "• Possible cause: Inflammation, triggers\n• Action: Use inhaler, avoid triggers\n• Limit: Keep emergency inhaler nearby\n• Warning: Severe breathing difficulty\n• Next: Emergency care for severe attacks",
        'allergy': "• Possible cause: Immune response to substance\n• Action: Avoid trigger, use antihistamines\n• Limit: Over-the-counter options available\n• Warning: Anaphylaxis - severe reaction\n• Next: Doctor if severe or recurring",
        'joint pain': "• Possible cause: Inflammation, injury, or arthritis\n• Action: Rest, ice, elevation, compression\n• Limit: Avoid strenuous activity\n• Warning: Severe swelling, unable to move\n• Next: Physical therapy or doctor evaluation",
        'muscle pain': "• Possible cause: Overexertion, injury, or tension\n• Action: Rest, stretching, warm compress\n• Limit: Pain relievers safe for short term\n• Warning: Severe or getting worse\n• Next: Doctor if pain persists >1 week",
        'back pain': "• Possible cause: Poor posture, strain, or injury\n• Action: Rest, hot compress, gentle stretches\n• Limit: Avoid heavy lifting\n• Warning: Leg numbness, loss of control\n• Next: Doctor if severe or radiating",
    }
    
    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super(BioHelpChatbot, cls).__new__(cls)
                    cls._instance._initialized = False
        return cls._instance
    
    def __init__(self):
        if hasattr(self, '_initialized') and self._initialized:
            return
            
        # Using a quantized GGUF version from MaziyarPanahi
        self.model_repo = "MaziyarPanahi/BioMistral-7B-GGUF"
        self.model_file = "BioMistral-7B.Q4_K_M.gguf"
        
        self.model = None
        self.is_loading = False
        self.load_error = None
        self._initialized = True
        self.use_fallback = not HAS_TRANSFORMERS
        self.model_warm = False  # ✅ Track if model has been warmed up
        self.last_response_time = 0

    @property
    def ready(self):
        """Property to indicate if chatbot is ready (always true as it has fallback)"""
        return True
        
    def warm_up_model(self):
        """✅ OPTIMIZATION 1: Model Warm-Up - Initializes CUDA/CPU kernels for fast first response"""
        if self.model is None or self.model_warm or not HAS_TRANSFORMERS:
            return
        
        try:
            start_time = time.time()
            # ✅ Send dummy request to initialize kernels
            prompt = "[INST] Hello [/INST]"
            _ = self.model(prompt, max_new_tokens=5)
            
            warm_time = time.time() - start_time
            self.model_warm = True
            print(f"[WARMUP] Model warmed up in {warm_time:.2f}s - Next responses will be fast!")
        except Exception as e:
            print(f"Warm-up failed (non-critical): {e}")
        
    def load_model(self):
        """Loads the BioMistral model using ctransformers (if available)"""
        if self.model is not None or self.is_loading or not HAS_TRANSFORMERS:
            return

        self.is_loading = True
        self.load_error = None
        
        try:
            # Step 1: Download/Get path explicitly without auth
            model_path = hf_hub_download(
                repo_id=self.model_repo,
                filename=self.model_file,
                token=False  # Explicitly disable token usage
            )

            # Step 2: Load from local path
            self.model = AutoModelForCausalLM.from_pretrained(
                model_path,
                model_type="mistral",
                gpu_layers=0, 
                context_length=512  # ✅ OPTIMIZATION: Reduced context for speed
            )
            
            # ✅ Warm up model immediately after loading
            self.warm_up_model()
            self.use_fallback = False
            
        except Exception as e:
            self.load_error = str(e)
            self.use_fallback = True
        finally:
            self.is_loading = False

    # Removed @lru_cache because it causes issues with module reloading during testing
    def _check_faq(self, user_input_lower: str) -> Optional[str]:
        """Check FAQ database first - instant response in milliseconds"""
        # Check exact FAQ matches
        for question, answer in self.MEDICAL_FAQ.items():
            if question in user_input_lower:
                return answer
            words_in_q = question.split()
            for word in words_in_q:
                if word in user_input_lower:
                    return answer
        return None

    def _get_raw_fallback_response(self, user_input: str) -> str:
        """Generate response using knowledge base when model is unavailable"""
        user_lower = user_input.lower()

        
        # ✅ FIRST: Check FAQ database (instant response)
        faq_response = self._check_faq(user_lower)
        if faq_response:
            print(f"DEBUG: Matched FAQ for '{user_input}'")
            return faq_response
        
        # Check for exact keyword matches
        for keyword, response in self.MEDICAL_KNOWLEDGE.items():
            if keyword in user_lower:
                return response
        
        # Check for symptom descriptions with improved matching
        symptom_keywords = {
            'fever|temperature|hot|heat|sweating': 'fever',
            'headache|head ache|head pain|migraine': 'headache',
            'cold|sneezing|runny nose': 'cold',
            'cough|coughing': 'cough',
            'tired|fatigue|sleepy|energy|weak|weakness': 'fatigue',
            'stomach|belly|digestion|nausea|vomit|gastric': 'stomach',
            'chest pain|heart pain|cardiac|angina': 'chest pain',
            'pressure|hypertension|bp|blood pressure': 'blood pressure',
            'blood sugar|glucose|diabetes|diabetic': 'diabetes',
            'asthma|wheeze|wheezing': 'asthma',
            'allerg|itch|rash|hive|itching': 'allergy',
            'back pain|back ache|lower back|spine pain': 'back pain',
            'joint pain|knee pain|ankle pain|shoulder pain|elbow pain|finger pain|hand pain|wrist pain': 'joint pain',
            'muscle pain|muscle ache|leg pain|arm pain|body pain': 'muscle pain',
        }
        
        for keywords, key in symptom_keywords.items():
            if any(kw in user_lower for kw in keywords.split('|')):
                if key in self.MEDICAL_KNOWLEDGE:
                    return self.MEDICAL_KNOWLEDGE[key]
        
        # Emergency detection
        if any(word in user_lower for word in ['emergency', 'urgent', 'critical', 'severe', '911', 'ambulance', 'dying', 'help now']):
            return "EMERGENCY: Call 911 immediately or go to nearest hospital if experiencing:\n• Chest pain\n• Severe shortness of breath\n• Signs of stroke (facial drooping, arm weakness)\n• Severe bleeding\n• Signs of heart attack"
        
        # General medical question
        return "Ask me about common symptoms:\n• Fever, headache, cough, cold\n• Stomach issues, fatigue, back pain\n• Blood pressure, diabetes, asthma\n• Or ask about health conditions\n\nI'm here to help!"

    def _get_fallback_response(self, user_input: str) -> str:
        """Wrapper to add disclaimer to fallback response"""
        return self._get_raw_fallback_response(user_input) + "\n\nThis information is for educational purposes only and is not a medical diagnosis."

    def get_response(self, user_input: str) -> str:
        """OPTIMIZED: Generates a response for the given user input with fast inference"""
        if not user_input or not user_input.strip():
            return "Please ask a health question."
        
        start_time = time.time()
        
        # ✅ OPTIMIZATION 2: Reduce input prompt size
        # Summarize/truncate user input
        user_input_clean = user_input.strip()[:200]  # Limit input to 200 chars
        
        # ✅ OPTIMIZATION 7: Always try FAQ/knowledge base first (instant)
        faq_response = self._check_faq(user_input_clean.lower())
        if faq_response:
            response_time = time.time() - start_time
            print(f"[FAQ] Response in {response_time:.3f}s")
            print(f"[FAQ] Response in {response_time:.3f}s")
            return faq_response + "\n\nThis information is for educational purposes only and is not a medical diagnosis."
        
        # PRIORITY: Use fallback knowledge base if model not available
        if self.use_fallback or self.load_error or not HAS_TRANSFORMERS:
            response = self._get_fallback_response(user_input_clean)
            response_time = time.time() - start_time
            print(f"[FALLBACK] Response in {response_time:.3f}s")
            print(f"[FALLBACK] Response in {response_time:.3f}s")
            print(f"[FALLBACK] Response in {response_time:.3f}s")
            return response
        
        # If model is not loaded and not loading, use fallback and start loading in background
        if not self.model and not self.is_loading and not self.load_error:
            load_thread = threading.Thread(target=self.load_model, daemon=True)
            load_thread.start()
            return self._get_fallback_response(user_input_clean)
        
        # If model is currently loading, use fallback
        if self.is_loading:
            return self._get_fallback_response(user_input_clean)
        
        # If we have a model, use it with optimizations
        if self.model:
            try:
                # ✅ OPTIMIZATION 3: Optimized system prompt with strict rules
                # Medical answers MUST be short and structured
                system_prompt = (
                    "You are a medical awareness assistant, NOT a doctor. "
                    "STRICT RULES: Do NOT diagnose, Do NOT confirm infections, Do NOT prescribe meds/antibiotics. "
                    "Do NOT claim medical authority. "
                    "ALLOWED: Explain general causes, self-care (rest/fluids), recommend doctors. "
                    "RESPONSE STYLE: Neutral, educational, short paragraphs. "
                    "MANDATORY: Allow ending with disclaimer."
                )
                
                prompt = f"[INST] {system_prompt}\nQuestion: {user_input_clean} [/INST]"
                
                # ✅ OPTIMIZATION 4: Enable KV-Cache and limit tokens
                response = self.model(
                    prompt, 
                    max_new_tokens=200,  # Increased slightly for better explanation
                    temperature=0.3,     # ✅ Lower temperature for consistent output
                    top_p=0.9,
                    # use_cache=True      # ✅ KV-Cache enabled in ctransformers
                    do_sample=False      # ✅ Deterministic output = faster
                )
                
                # Handle response format
                if isinstance(response, dict):
                    response_text = response.get('text', str(response))
                else:
                    response_text = str(response)
                
                response_time = time.time() - start_time
                print(f"✅ AI Response in {response_time:.3f}s")
                
                # Append mandatory disclaimer
                final_response = response_text.strip() + "\n\nThis information is for educational purposes only and is not a medical diagnosis."
                return final_response
                
            except Exception as e:
                # Fall back to knowledge base on error
                return self._get_fallback_response(user_input_clean)
        
        # Fallback for any other case
        return self._get_fallback_response(user_input_clean)
    
    def __new__(cls):
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super(BioHelpChatbot, cls).__new__(cls)
                    cls._instance._initialized = False
        return cls._instance
    

    def __init__(self):
        if hasattr(self, '_initialized') and self._initialized:
            return
            
        # Using a quantized GGUF version from MaziyarPanahi
        self.model_repo = "MaziyarPanahi/BioMistral-7B-GGUF"
        self.model_file = "BioMistral-7B.Q4_K_M.gguf"
        
        self.model = None
        self.is_loading = False
        self.load_error = None
        self._initialized = True
        self.use_fallback = not HAS_TRANSFORMERS
        self.model_warm = False
        
        # Dataset attributes
        self.dataset_dir = Path("trained_models/medical_dataset")
        self.qa_pairs = []
        self.qa_indexed = {}
        self.dataset_ready = False
        
        # Start loading dataset in background
        self._load_dataset_thread = threading.Thread(target=self._load_dataset, daemon=True)
        self._load_dataset_thread.start()

    def _load_dataset(self):
        """Load the medical Q&A dataset"""
        try:
            qa_file = self.dataset_dir / "medical_qa_pairs.json"
            
            if qa_file.exists():
                print("⏳ Loading medical Q&A dataset... (256k+ Q&A pairs)")
                with open(qa_file, 'r', encoding='utf-8') as f:
                    self.qa_pairs = json.load(f)
                print(f"✅ Loaded {len(self.qa_pairs)} Q&A pairs from dataset")
                
                self._create_index()
                self.dataset_ready = True
            else:
                print(f"❌ Dataset file not found: {qa_file}")
                
        except Exception as e:
            print(f"❌ Error loading dataset: {e}")
            self.dataset_ready = False

    def _create_index(self):
        """Create keyword index for fast searching"""
        try:
            print("📝 Building keyword index...")
            stopwords = {'what', 'is', 'how', 'are', 'the', 'and', 'or', 'for', 'you', 'your', 'i', 'a', 'an', 'my', 'from', 'with'}
            
            for idx, qa in enumerate(self.qa_pairs):
                # Basic progress log
                if idx > 0 and idx % 100000 == 0:
                    print(f"   Indexed {idx:,} pairs...")
                    
                question = qa['question'].lower()
                words = re.findall(r'\w+', question)
                
                for word in words:
                    if len(word) >= 3 and word not in stopwords:
                        if word not in self.qa_indexed:
                            self.qa_indexed[word] = []
                        if not self.qa_indexed[word] or self.qa_indexed[word][-1] != idx:
                            self.qa_indexed[word].append(idx)
                            
            print(f"✅ Created index with {len(self.qa_indexed):,} keywords")
        except Exception as e:
            print(f"❌ Index creation failed: {e}")

    def _find_best_matches(self, query: str, top_k: int = 3) -> List[Dict]:
        """Find best matching Q&A pairs from dataset"""
        if not self.dataset_ready:
            return []
            
        query_lower = query.lower()
        query_words = [w for w in re.findall(r'\w+', query_lower) if len(w) >= 3]
        
        if not query_words:
            return []
        
        # Find candidates using keyword index
        candidate_counts = {}
        for word in query_words:
            if word in self.qa_indexed:
                for idx in self.qa_indexed[word]:
                    candidate_counts[idx] = candidate_counts.get(idx, 0) + 1
        
        if not candidate_counts:
            return []
        
        # Score candidates
        sorted_candidates = sorted(candidate_counts.items(), key=lambda x: x[1], reverse=True)
        
        scored_results = []
        for idx, overlap_count in sorted_candidates[:100]:  # Limit candidates
            qa = self.qa_pairs[idx]
            question_lower = qa['question'].lower()
            
            # String similarity (SequenceMatcher is slow but accurate)
            similarity = SequenceMatcher(None, query_lower, question_lower).ratio()
            keyword_score = overlap_count / len(query_words) if query_words else 0
            
            final_score = (keyword_score * 7.0) + (similarity * 3.0)
            scored_results.append((final_score, qa))
        
        scored_results.sort(key=lambda x: x[0], reverse=True)
        
        # Return top K matches
        return [qa for score, qa in scored_results[:top_k]]

    def load_model(self):
        """Loads the BioMistral model using ctransformers"""
        if self.model is not None or self.is_loading or not HAS_TRANSFORMERS:
            return

        self.is_loading = True
        self.load_error = None
        
        try:
            print(f"Attempting to download/load {self.model_file} from {self.model_repo}...")
            model_path = hf_hub_download(
                repo_id=self.model_repo,
                filename=self.model_file,
                token=False
            )
            
            self.model = AutoModelForCausalLM.from_pretrained(
                model_path,
                model_type="mistral",
                gpu_layers=0, 
                context_length=2048
            )
            
            self.warm_up_model()
            self.use_fallback = False
            print("✅ BioMistral-7B loaded successfully.")
            
        except Exception as e:
            print(f"❌ Error loading BioMistral: {str(e)}")
            self.load_error = str(e)
            self.use_fallback = True
        finally:
            self.is_loading = False

    def warmed_up_model(self):
         pass

    def get_response(self, user_input: str) -> str:
        """RAG-Enabled Response Generation"""
        if not user_input or not user_input.strip():
            return "Please ask a health question."
            
        start_time = time.time()
        user_input_clean = user_input.strip()[:200]
        
        # 1. Dataset Search (Context Retrieval)
        context = ""
        matches = self._find_best_matches(user_input_clean)
        
        if matches:
            context = "Context from verified medical dataset:\n"
            for i, match in enumerate(matches):
                context += f"Q: {match['question']}\nA: {match['answer']}\n\n"
            print(f"✅ Found {len(matches)} relevant Q&A pairs in dataset")
        else:
            print("⚠️ No relevant data found in dataset for RAG")

        # 2. Check Model Status
        if not self.model and not self.is_loading and not self.load_error:
            load_thread = threading.Thread(target=self.load_model, daemon=True)
            load_thread.start()
            
            # If we simply found a direct match, return it while model loads
            if matches:
                 return f"💊 {matches[0]['answer']}"
        
        # 3. Use Model with Context (RAG)
        if self.model:
            try:
                system_prompt = (
                    "You are a helpful medical assistant. "
                    "Use the provided context to answer the user's question. "
                    "If the context contains the answer, use it. "
                    "If not, provide a general, safe medical explanation. "
                    "Do NOT diagnose. Keep answers concise."
                )
                
                input_prompt = f"[INST] {system_prompt}\n\nContext:\n{context}\n\nUser Question: {user_input_clean} [/INST]"
                
                response = self.model(
                    input_prompt, 
                    max_new_tokens=250,
                    temperature=0.3,
                    do_sample=False
                )
                
                response_text = response if isinstance(response, str) else response.get('text', str(response))
                return response_text.strip()
                
            except Exception as e:
                print(f"Model Inference Failed: {e}")
                # Fallback to direct dataset match if model fails
                if matches:
                    return f"💊 {matches[0]['answer']}"
        
        # 4. Fallback if model missing but dataset match exists
        if matches:
            return f"💊 {matches[0]['answer']}"

        # 5. Final Fallback (Rule-based)
        return self._get_fallback_response(user_input_clean)
